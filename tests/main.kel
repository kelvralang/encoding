const encoding = @import("github.com/kelvralang/encoding")
fn assert(condition bool, message str) void { if (!condition) error(message) }

assert(encoding.hexEncode("Kelvra!") == "4b656c76726121", "hex encoding")
assert(encoding.hexDecode("4B656C76726121") == "Kelvra!", "hex decoding accepts uppercase digits")
assert(encoding.hexEncode("") == "" && encoding.hexDecode("") == "", "empty hex round trip")
assert(encoding.base64Encode("M") == "TQ==", "base64 one-byte padding")
assert(encoding.base64Encode("Mo") == "TW8=", "base64 two-byte padding")
assert(encoding.base64Decode("S2VsdnJh") == "Kelvra", "base64 decoding")
assert(encoding.base64Decode(encoding.base64Encode("any carnal pleasure.")) == "any carnal pleasure.", "base64 round trip")
assert(encoding.base64Encode("") == "" && encoding.base64Decode("") == "", "empty base64 round trip")
assert(encoding.urlEncode("a b/c?") == "a%20b%2fc%3f", "URL encoding")
assert(encoding.urlDecode("a%20b%2Fc%3F") == "a b/c?", "URL decoding")
assert(encoding.urlEncode("AZaz09-._~") == "AZaz09-._~", "URL unreserved characters")
assert(encoding.urlDecode(encoding.urlEncode("x=y&z")) == "x=y&z", "URL round trip")
assert(encoding.adler32("") == "00000001", "Adler-32 empty vector")
assert(encoding.adler32("Wikipedia") == "11e60398", "Adler-32 standard vector")
assert(encoding.checksum("kelvra") == "31303132343435353838", "stable checksum")
assert(encoding.legacyPolynomialChecksum("kelvra") == encoding.checksum("kelvra"), "legacy checksum compatibility")
